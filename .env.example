# Base de datos (PostgreSQL / Supabase)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=change_me
DB_NAME=inmobiliaria
# Esquema de la base; si no se define se usa "public"
DB_SCHEMA=public

# Para Supabase usá el host y las credenciales de tu proyecto, por ejemplo:
# DB_HOST=aws-0-xx.pooler.supabase.com
# DB_PORT=5432
# DB_USER=postgres.xxxxxxxx
# DB_NAME=postgres

# Entorno: development | production
NODE_ENV=development

# Puerto de la API
PORT=3000

# Secreto para firmar los JWT (obligatorio, usá un valor largo y aleatorio)
JWT_SECRET=change_me_to_a_long_random_string

# Origen del frontend permitido por CORS en producción
FRONTEND_URL=http://localhost:3001

# En producción Swagger UI (/api) queda apagado; con true se publica
# ENABLE_SWAGGER=true

# Primer superusuario: npm run seed:superuser
SUPERUSER_EMAIL=admin@example.com
SUPERUSER_PASSWORD=change_me
SUPERUSER_NAME=Superuser
