# Base de datos - Supabase/PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=password
DB_NAME=inmobiliaria

# Para Supabase, usa el host y credenciales de tu proyecto Supabase
# Ejemplo Supabase:
# DB_HOST=xxxx.supabase.co
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=tu_password_supabase
# DB_NAME=postgres

# Entorno
NODE_ENV=development

# JWT
JWT_SECRET=tu_jwt_secret_super_seguro_aqui

# Puerto API
PORT=3000
